{
  "name": "app-nha-an",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:prod": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "cap:sync": "npx cap sync",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "build-apk": "npm run build:prod && npm run cap:sync && npm run android:build",
    "android:install": "cd android && gradlew.bat installDebug",
    "android:devices": "adb devices",
    "android:uninstall": "adb uninstall vn.hoaphatdungquat.appnhaan",
    "android:run": "npm run build-apk && npm run android:install",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.1",
    "@reduxjs/toolkit": "^2.2.6",
    "@tinymce/tinymce-react": "^6.3.0",
    "antd": "^5.20.0",
    "axios": "^1.7.2",
    "chart.js": "^4.4.4",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "sass": "^1.103.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/chart.js": "^2.9.41",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.3.4"
  }
}
